# ==============================================================================
# SupplyAI 后端配置示例
# ------------------------------------------------------------------------------
# 用法:
#   cp .env.example .env
#   填入你的 DASHSCOPE_API_KEY (或 SUPPLY_DASH_API_KEY)
# ------------------------------------------------------------------------------
# 加载机制:
#   - supplyai.config.Settings (pydantic-settings) 启动时自动读取本文件 + 进程环境变量
#   - 进程环境变量优先于 .env(生产 / CI 用)
#   - 所有 key 大小写不敏感;部分 key 接受多个别名(下方注释会列出)
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# 应用基础
# ──────────────────────────────────────────────────────────────────────────────

# 运行环境:local / staging / production
# - local: 本地开发,SQLite + 进程内 LRU + FastAPI BackgroundTasks
# - staging / production: 同代码,只需切 DATABASE_URL / CACHE_BACKEND / TASK_RUNNER
APP_ENV=local

# 日志级别:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志格式:console(本地易读)/ json(生产抓取)
LOG_FORMAT=console


# ──────────────────────────────────────────────────────────────────────────────
# 数据库
# ──────────────────────────────────────────────────────────────────────────────

# SQLAlchemy 异步连接串
# - 本地 SQLite(无 daemon,文件存储):
#     sqlite+aiosqlite:///./data/supplyai.db
# - 生产 MySQL 8.0+(aiomysql 驱动,需先 `uv sync --extra prod`):
#     mysql+aiomysql://user:password@db-host:3306/supplyai?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./data/supplyai.db


# ──────────────────────────────────────────────────────────────────────────────
# AI 服务(DashScope / Qwen)
# ──────────────────────────────────────────────────────────────────────────────

# AI 服务商,当前仅支持 dashscope(阿里云百炼)
AI_PROVIDER=dashscope

# 使用的模型名,Qwen 系列推荐 qwen3.6-plus / qwen-plus / qwen-turbo
AI_MODEL=qwen3.6-plus

# 模型上下文窗口与回复长度上限
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1024

# 多轮对话保留的轮次(超过则截断最旧)
AI_HISTORY_TURNS=8

# DashScope API key — 必填,否则 /ai/* 端点抛 AiClientNotConfigured
# 接受别名:SUPPLY_DASH_API_KEY / DASHSCOPE_API_KEY
SUPPLY_DASH_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DashScope endpoint
# - 官方公网:https://dashscope.aliyuncs.com/compatible-mode/v1
# - 阿里云自部署 endpoint 形如:
#     https://ws-XXXXX.cn-beijing.maas.aliyuncs.com/api/v1
#   (代码自动把 /api/v1 → /compatible-mode/v1,无需手改)
# 接受别名:SUPPLY_DASH_URL / DASHSCOPE_BASE_URL
SUPPLY_DASH_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 自部署 endpoint 证书可能与 hostname 不匹配,关闭 SSL 校验(仅本地开发用)
# 生产请保持 true
SUPPLY_DASH_VERIFY_SSL=true

# 思维链(reasoning_content)开关 — 默认 true
# - true:  Qwen3.x 生成思考链,前端在折叠面板里实时展示;
#          首条 reasoning_delta ~0.5-1s 到达,完整答复时长 ~30-60s
# - false: 直接跳过思考,首条答复 token <1s 到达;
#          代价:答复质量略降(无内部推理),节省 token
SUPPLY_DASH_ENABLE_THINKING=true


# ──────────────────────────────────────────────────────────────────────────────
# 缓存
# ──────────────────────────────────────────────────────────────────────────────

# 缓存后端:memory(进程内 LRU,默认)/ redis(生产)
CACHE_BACKEND=memory

# 缓存默认 TTL(秒)
CACHE_DEFAULT_TTL=60

# Redis URL — 仅 CACHE_BACKEND=redis 时使用
# 生产示例:redis://:password@redis-host:6379/0
# REDIS_URL=


# ──────────────────────────────────────────────────────────────────────────────
# 后台任务
# ──────────────────────────────────────────────────────────────────────────────

# 任务运行器:local(FastAPI BackgroundTasks)/ celery(生产 Celery + Redis)
TASK_RUNNER=local


# ──────────────────────────────────────────────────────────────────────────────
# 多租户 / 数据演示
# ──────────────────────────────────────────────────────────────────────────────

# 默认租户 ID(seed 数据 = 100228)
DEFAULT_TENANT_ID=100228

# 默认基准币种(财务多币种折算的目标币)
DEFAULT_BASE_CURRENCY=USD


# ──────────────────────────────────────────────────────────────────────────────
# 鉴权(Phase 5,生产启用)
# ──────────────────────────────────────────────────────────────────────────────

# JWT 签名密钥 — 至少 32 字节,生产请用 `openssl rand -hex 32` 生成
# JWT_SECRET=

# JWT 签名算法
JWT_ALGORITHM=HS256


# ──────────────────────────────────────────────────────────────────────────────
# 导出
# ──────────────────────────────────────────────────────────────────────────────

# 导出文件落盘目录(.gitignored)
EXPORT_DIR=./data/exports

# 行数 ≤ 此值则 /exports/sku-list 同步生成 xlsx;否则走异步任务
EXPORT_SYNC_THRESHOLD=5000
